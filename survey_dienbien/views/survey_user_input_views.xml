<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="survey_user_input_view_form_db" model="ir.ui.view">
            <field name="name">survey.user_input.inherit</field>
            <field name="model">survey.user_input</field>
            <field name="inherit_id" ref="survey.survey_user_input_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//group/group[1]/field[@name='test_entry']" position="after">
                    <field name="xep_loai"/>
                    <field name="input_important"/>

                </xpath>
            </field>
        </record>

        <record id="survey_user_input_view_tree_db" model="ir.ui.view">
            <field name="name">survey.user_input.inherit</field>
            <field name="model">survey.user_input</field>
            <field name="inherit_id" ref="survey.survey_user_input_view_tree"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='scoring_percentage']" position="after">
                    <field name="xep_loai" optional="show"/>
<!--                    <field name="input_important"/>-->
                </xpath>
            </field>
        </record>
    </data>
</odoo>