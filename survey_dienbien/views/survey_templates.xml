<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="question_container_inherit" inherit_id="survey.question_container">
            <!-- Thêm số thứ tự trước tiêu đề câu hỏi -->
            <xpath expr="//h3/span[@t-field='question.title']" position="before">
                <!-- Khởi tạo biến đếm -->
                <t t-set="counter" t-value="0"/>

                <!-- Kiểm tra nếu biến `page` tồn tại, nếu không sử dụng `survey` -->
                <t t-foreach="(page and page.question_ids or survey.question_ids)" t-as="q">
                    <t t-set="counter" t-value="counter + 1"/> <!-- Tăng giá trị biến đếm -->
                    <t t-if="q == question">
                        <span>Câu <t t-esc="counter"/>. </span> <!-- Hiển thị số thứ tự câu hỏi -->
                    </t>
                </t>
            </xpath>
        </template>

        <template id="survey_question_border_inherit" inherit_id="survey.question_container">
            <xpath expr="//div[contains(@t-attf-class, 'js_question-wrapper')]" position="attributes">
                <attribute name="style">border: 1px solid #ddd; padding: 15px; margin-bottom: 15px; border-radius: 8px;</attribute>
            </xpath>
        </template>


    <template id="survey_fill_form_done_inherit" inherit_id="survey.survey_fill_form_done" name="Survey: Finished Inherit">
        <!-- Chèn nút "Quay về trang chủ" sau đoạn "Congratulations, you have passed the test!" -->
        <xpath expr="//div/div/div[2]/div[1]/t[1]/t[1]/div[1]" position="inside">
            <t t-if="survey.is_attempts_limited">
                    <t t-set="attempts_left" t-value="survey._get_number_of_attempts_lefts(answer.partner_id, answer.email, answer.invite_token)" />
                    <t t-if="attempts_left > 0">
                        <p><span>Số lần thử còn lại</span>: <span t-esc="attempts_left"></span></p>
                        <p><a role="button" class="btn btn-primary btn-lg" t-att-href="'/survey/retry/%s/%s' % (survey.access_token, answer.access_token)">
                        Thử lại</a></p>
                    </t>
                </t>
                <t t-else="">
                    <p><a role="button" class="btn btn-primary btn-lg" t-att-href="'/survey/retry/%s/%s' % (survey.access_token, answer.access_token)">
                        Thử lại</a></p>
                </t>
            <div class="mt16">
                <a href="/" class="btn btn-secondary btn-lg">
                    <i class="fa fa-home" aria-hidden="true"></i>
                    Quay về trang chủ
                </a>
            </div>
        </xpath>
    </template>



    </data>
</odoo>